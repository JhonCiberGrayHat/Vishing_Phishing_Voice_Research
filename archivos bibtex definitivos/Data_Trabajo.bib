@CONFERENCE{Bhuvaneswari20242011,
	author = {Bhuvaneswari, K. and Roshni, A. and Padmavathi, G.},
	title = {Evaluation of Selected Supervised Machine Learning Models for Phishing Website Detection},
	year = {2024},
	journal = {15th International Conference on Advances in Computing, Control, and Telecommunication Technologies, ACT 2024},
	volume = {1},
	pages = {2011 - 2018},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208790072&partnerID=40&md5=1445439737b0ee7cc5f8afe78b506c86},
	affiliations = {Avinashilingam Institute of Home Science and Higher Education for Women, Department of Computer Science, Tamilnadu, Coimbatore, India; Avinashilingam Institute of Home Science and Higher Education for Women, Centre for Cyber Intelligence, Tamilnadu, Coimbatore, India},
	abstract = {Phishing is a kind of cyber security attack where malicious users send messages or emails while assuming the identity of legitimate individuals or organizations. Day by day phishing attacks evolve tremendously in global scale. Phishing attacks may target the system/user in various forms such as phishing emails, SMS (Smishing), Voice messages (Vishing) or through anonymous links (Website URL). Due to this risk, it is the need of the hour to recognize those kinds of phishing attacks using Machine Learning (ML) techniques. The objective of this paper is to determine the suitable machine learning model to detect website phishing attacks. The developed ML models to detect website phishing attacks are Support Vector Machine, K-Nearest Neighbor, Random forest, Decision tree, and Logistic regression. Phishing mendeley dataset 2020 is used to carry out the study. The taken dataset consists of 111 attributes and 58,645 records, out of which 27,998 are phishing websites and 30,747 are real websites. A standard ML model development process is carriedout to develop a suitable model for phishing website detection with filter based feature selection methods. Top 20, 40, and 60 features are selected using univariate feature selection approach. For the selected features, the above mentioned five supervised machine learning models are developed. Further, the developed models are evaluated using the metrics such as accuracy, precision, recall, f1 score, and receiver operating characteristics curve. A comparative analysis between the models with top 20, 40, and 60 features has been done, to suggest the suitable ML model for phishing website detection with appropriate features. After experimentation, it is noted that the highest accuracy 98.6% is attained by the Random Forest model with Mutual info regression with top 60 features. © Grenze Scientific Society, 2024.},
	author_keywords = {Filter based features; Phishing Attack; Supervised Learning; Univariate Analysis; Website Phishing Detection},
	keywords = {Adversarial machine learning; Contrastive Learning; Cyber attacks; Random forests; Self-supervised learning; Support vector machines; Websites; Filter based feature; Filter-based; Machine learning models; Phishing; Phishing attacks; Phishing detections; Phishing websites; Supervised machine learning; Univariate analysis; Website phishing detection; Phishing},
