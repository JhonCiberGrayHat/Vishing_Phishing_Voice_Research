	title = {Biometric-based access control mechanism for edge computing resources and services},
	year = {2025},
	journal = {Cybersecurity Defensive Walls in Edge Computing},
	pages = {317 - 336},
	doi = {10.1016/B978-0-443-34109-0.00010-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105026845775&doi=10.1016%2FB978-0-443-34109-0.00010-3&partnerID=40&md5=3faf249bc3a065e3f2629238652746d4},
	affiliations = {Centre for Augmented Intelligence and Data Science (CAIDS), School of Computing, University of South Africa, Florida Campus, Roodepoort, South Africa; Department of Electrical and Smart Systems Engineering, School of Computing, University of South Africa, Florida Campus, Roodepoort, South Africa},
	abstract = {Edge computing involves the deployment of computing resources and services at the edge of the network. Edge resources and services facilitate real-time processing, enhanced scalability, and reduced latency, enabling seamless support for essential applications in IoT, smart cities, industrial automation, and other areas. However, this increased dependency on edge computing requires the implementation of robust edge security measures. Traditional access control measures, such as passwords and tokens, are easily susceptible to compromise through phishing scams, brute-force attacks, and other methods. Consequently, edge computing environments face increased risks of unauthorized access, emphasizing the need for more robust and advanced security solutions. Recently, biometric-based access control mechanisms have been employed to protect edge resources and services. These mechanisms utilize unique physical or behavioral characteristics, such as facial recognition, fingerprint scanning, voice recognition, and iris recognition, to provide enhanced security. This paper studies a novel biometric-based access control mechanism for edge resources and services. We discuss common biometric-based authorization and authentication mechanisms employed in edge computing and examine the unique physical characteristics of common biometric modalities and techniques used in edge computing, highlighting their strengths and weaknesses. We provide an overview of common edge resources, including biometric sensors and authentication servers. In addition, we conducted a comparative study between biometric-based mechanisms and other approaches, including password-based, token-based, and smart card-based access control mechanisms. We also explore the benefits and advantages of biometric-based mechanisms over other approaches, particularly in real-time scenarios. This study serves as a valuable resource and guide for organizations seeking to improve the security and management of their edge resources and services. © 2026 Elsevier Inc. All rights reserved..},
	author_keywords = {access control; authentication; authorization; Biometric; edge resources; edge services},
	keywords = {Computer crime; Edge computing; Edge detection; Face recognition; Network security; Palmprint recognition; Access control mechanism; Computing resource; Computing services; Edge computing; Edge resources; Edge services; Industrial automation; Physical characteristics; Realtime processing; Reduced latencies; Authentication; Biometrics},
	publisher = {Elsevier},
	isbn = {978-044334109-0; 978-044334110-6},
	language = {English},
	abbrev_source_title = {Cybersecurity Defensive Walls in Edge Computing},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@BOOK{Dharmavaram202281,
	author = {Dharmavaram, Vijaya Geeta and Mishra, Oly},
	title = {KYC fraud: A new means to conduct financial fraud - How to tackle it?},
	year = {2022},
	journal = {Cybersecurity Issues, Challenges, and Solutions in the Business World},
	pages = {81 - 94},
	doi = {10.4018/978-1-6684-5827-3.ch006},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85162146082&doi=10.4018%2F978-1-6684-5827-3.ch006&partnerID=40&md5=003619c5745ce3e8b51bd4aaafe4ad71},
	affiliations = {GITAM School of Business, India; Indian Institute of Foreign Trade, India},
	abstract = {Know your customer (KYC) is a measure adopted by financial institutions like banks to render timely services to their legitimate customers. Cybercriminals are resorting to KYC fraud through Vishing and SMiShing attacks. Customers have been falling prey to such frauds in the name of KYC updation. The chapter proposes the application of the supervised machine learning model to detect KYC fraud related to SMS and prevent such frauds. A dataset of sample KYC fraud messages and non-fraud messages is taken to train the machine learning model. The model is trained to extract the relevant features that distinguish fraud messages from valid messages, thus detecting fraud messages. The model was tested with popular supervised machine learning algorithms. The proposed model may be made as part of a security patch in the messaging service. KYC fraud has become rampant in recent times, and the chance of an individual falling for such attacks are highest given that it is a mandatory process. Previous research studies provided generic solutions for such frauds. © 2023, IGI Global. All rights reserved.},
	publisher = {IGI Global},
	isbn = {978-166845829-7; 978-166845827-3},
	language = {English},
