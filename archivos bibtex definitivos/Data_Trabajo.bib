	journal = {Computers and Electrical Engineering},
	volume = {130},
	pages = {},
	doi = {10.1016/j.compeleceng.2025.110829},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105022500100&doi=10.1016%2Fj.compeleceng.2025.110829&partnerID=40&md5=3ae1f60f0d6c8cac5aa57ed893c9dace},
	affiliations = {Department of Computer Science and Engineering, School of Computer Science and Engineering, SR University, Telangana, Warangal, 506371, India; Department of Mechanical Engineering, Karunya Institute of Technology and Sciences, Tamil Nadu, Coimbatore, 641114, India; Centre for Research in Material Science and Thermal Management (CRMS &TM), Karunya Institute of Technology and Sciences, Tamil Nadu, Coimbatore, 641114, India},
	abstract = {Phishing remains a persistent and evolving threat in the cybersecurity landscape, leveraging weaknesses in various digital platforms. The increasing sophistication of these attacks underscores the limitations of conventional filters and rule-based defenses, highlighting the need for intelligent detection approaches. This review adopts a structured methodology, surveying and categorizing recent literature on phishing detection with a focus on Machine Learning, Deep Learning, and Hybrid models. Studies are analyzed by phishing vector, including email, URL, social engineering, smishing, voice and video phishing, and cloud-based attacks. The findings reveal that Deep Learning architectures such as Convolutional and Recurrent Neural Networks consistently achieve detection accuracies exceeding 95 %, particularly for email and URL phishing, while Hybrid and Ensemble frameworks demonstrate enhanced adaptability to multi-vector threats. The integration of Explainable Artificial Intelligence is emerging as a critical trend, providing greater transparency, interpretability, and regulatory alignment. Despite these advancements, challenges remain in countering adversarial evasion, overcoming dataset limitations, ensuring cross-domain generalization, and achieving scalable deployment. The review concludes by recommending the development of resilient, interpretable, and integrated detection frameworks to strengthen sustainable phishing defense in rapidly evolving digital ecosystems. © 2025 Elsevier Ltd.},
	author_keywords = {Adversarial training; Deep learning models; Explainable cybersecurity; Federated learning; Intelligent cybersecurity; Phishing mitigation},
	keywords = {Behavioral research; Computer crime; Cybersecurity; Deep neural networks; Ecosystems; Federated learning; Learning systems; Network security; Phishing; Attack detection; Cyber security; Deep learning model; Explainable cybersecurity; Intelligent cybersecurity; Learning models; Phishing; Phishing attacks; Phishing mitigation; Electronic mail},
