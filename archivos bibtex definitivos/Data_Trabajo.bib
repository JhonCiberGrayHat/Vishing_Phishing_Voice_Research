	publisher = {Emerald Publishing},
	issn = {20564961},
	language = {English},
	abbrev_source_title = {Inf. Comput. Security},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6}
}

