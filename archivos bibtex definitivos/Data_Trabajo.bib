	journal = {Proceedings - 2025 5th International Conference on Expert Clouds and Applications, ICOECA 2025},
	pages = {192 - 202},
	doi = {10.1109/ICOECA66273.2025.00042},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105015407809&doi=10.1109%2FICOECA66273.2025.00042&partnerID=40&md5=c3528680a9ac31f53ae60565534a4ab4},
	affiliations = {SREC, Department of Computer Applications, A.P, Nandyal, India},
	abstract = {With the increasing complexity of cyber threats, traditional single-factor authentication systems have become highly vulnerable to attacks such as phishing, brute force, and social engineering. This research proposes an advanced multi- modal authentication system that integrates face recognition, voice recognition, and image grid selection, coupled with randomized challenge tasks to prevent unauthorized access. The system also incorporates Role-Based Access Control (RBAC) for secure file management, ensuring that sensitive data is accessible only to authorized users based on predefined roles. The integration of audit trails provides full traceability of user activities, enhancing accountability and compliance. The proposed system was evaluated for authentication accuracy, processing time, and security efficiency. Results indicate that face recognition achieved 95.6% accuracy, voice recognition 89.3%, and image grid selection 100% accuracy. The system also successfully restricted unauthorized access through RBAC, demonstrating improved security, reduced false positives (0%), and efficient file access management. This research presents a scalable and adaptable security framework for organizations seeking a robust authentication system with enhanced data protection and user accountability.  © 2025 IEEE.},
