@ARTICLE{Chow2009267,
	author = {Chow, Stanley T. and Gustave, Christophe and Vinokurov, Dmitri},
	title = {Authenticating displayed names in telephony},
	year = {2009},
	journal = {Bell Labs Technical Journal},
	volume = {14},
	number = {1},
	pages = {267 - 282},
	doi = {10.1002/bltj.20367},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-66749159007&doi=10.1002%2Fbltj.20367&partnerID=40&md5=26bd8f460b7d87a7300c3c72709fc025},
	affiliations = {Security Research at Bell Labs, Institute of Electrical and Electronics Engineers (IEEE), Ottawa, Canada; Alcatel-Lucent Bell Labs, Ottawa, Canada; Alcatel-Lucent, Ottawa, Canada},
	abstract = {In both traditional and Internet Protocol (IP) telephony, a caller ID number is subject to control and verification, whereas the displayable caller ID name is a convenience feature which operators have no control over. It may be arbitrarily set by the caller. Voice phishing can exploit this weakness-e.g., make a call spoofing the name of a bank and ask for account information. We present a framework that allows each call participant to authenticate the displayed name of other parties via public name registries and International Telecommunication Union Telecom Standardization Sector (ITU-T) X.509 certificates. The authentication can work end-to-end, on-demand, for both called and calling party's name, for Voice over Internet Protocol (VoIP), landline, or mobile endpoints. The framework is flexible, does not require global public key infrastructure (PKI), and allows concerned financial, medical, and legal institutions to delegate the use of their authenticated names to employees outside the office as well as outsourcing companies. A proof-of-concept implementation is also presented. © 2009 Alcatel-Lucent.},
	keywords = {Authentication; Internet; Internet telephony; Outsourcing; Packet networks; Public key cryptography; Security of data; Voice/data communication systems; Wireless networks; Wireless telecommunication systems; Caller ID; International telecommunication unions; Internet protocol telephonies; Landline; Mobile endpoints; On-Demand; Outsourcing companies; Phishing; Proof of concept; Public-key infrastructure; TeleCOM; Voice over Internet protocol; X.509 certificates; Internet protocols},
	issn = {15387305},
	coden = {BLTJF},
	language = {English},
	abbrev_source_title = {Bell Labs Tech J},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 8}
}

