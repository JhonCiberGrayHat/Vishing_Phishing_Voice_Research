	keywords = {Audio acoustics; Classification (of information); Computer crime; Learning algorithms; Losses; Natural language processing systems; Robotics; Acoustic signature analysis; Audio feature analyse; Audio features; Classification models; Cyber security; Cyber-crimes; Feature analysis; Social engineering; Synthetic voices; Vishing; Cybersecurity},
