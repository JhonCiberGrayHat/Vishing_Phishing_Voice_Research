	note = {Cited by: 28; Conference name: 11th ACM Asia Conference on Computer and Communications Security, ASIA CCS 2016; Conference sponsors: ACM SIGSAC; Conference code: 122003; Conference date: 30 May 2016 through 3 June 2016; All Open Access; Green Open Access}
}

