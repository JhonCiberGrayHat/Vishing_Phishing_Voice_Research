	author = {Jakobsson, Niklas and Gerell, Manne},
	title = {Evaluating the impact of an informational postcard campaign on telephone scams targeting the elderly},
	year = {2023},
	journal = {Nordic Journal of Criminology},
	volume = {25},
	number = {1},
	pages = {},
	doi = {10.18261/njc.25.1.2},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85188685209&doi=10.18261%2Fnjc.25.1.2&partnerID=40&md5=e3776f7f6b96e33e1ccfb47d385f689b},
	affiliations = {Department of Criminology, Malmö University, Sweden; Karlstad Business School, Karlstad University, Sweden},
	abstract = {To combat the increasing incidence of telephone scams targeting the elderly, the Swedish Police initiated an informational campaign in 2023. This campaign involved distributing educational postcards to households with at least one resident aged 70 or older. We assess the effectiveness of the postcard intervention by comparing the change in the outcome variable (number of plaintiffs) among individuals aged 70 and above to those below 70. Despite the campaign’s aim to increase awareness and offer practical advice for avoiding scams, our analysis reveals no impact on the number of plaintiffs exposed to fraud. Our study did not identify any significant effects, adding to the existing body of literature on the effectiveness of information in influencing crime-related behaviors, where findings have been inconclusive. © 2024 Author(s).},
	author_keywords = {crime prevention; crimes against the elderly; fraud; information campaign; vishing},
