@CONFERENCE{Shelupanova20232020,
	author = {Shelupanova, Polina A. and Davydchenko, Polina Yu. and Ivanova, Daria V. and Muromtsev, Roman M. and Cholokogly, Mikhail A. and Chudina, Svetlana A.},
	title = {Video Identification as a Tool to Prevent Social Engineering Attacks in Finance},
	year = {2023},
	journal = {International Conference of Young Specialists on Micro/Nanotechnologies and Electron Devices, EDM},
	volume = {2023-June},
	pages = {2020 - 2023},
	doi = {10.1109/EDM58354.2023.10225086},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85171982048&doi=10.1109%2FEDM58354.2023.10225086&partnerID=40&md5=d730012066a6d278062b7232c76c4b8a},
	affiliations = {Tomsk State University of Control Systems and Radio Electronics, Tusur, Faculty of Security, Tomsk, Russian Federation},
	abstract = {Currently, there is an increase in cybercrime. More often, social engineering methods are used to implement fraudulent activities. The most common methods are phishing (a scammer sends an email on behalf of a trusted source to one or more users), vishing (a scammer pretends to be an employee of a well-known organization during a phone call to get the user's personal information) and smishing (a scammer sends SMS messages on behalf of a well-known organization with false information). Bank customers often become victims of fraudulent exposure. This work is devoted to the study of problems associated with attacks in banking and e-commerce using social engineering. As their solution, the developed software product 'DoubleCheck' was proposed to protect bank customers from cyber fraud using video identification. This technology allows for reliable remote customer service, confirming their identity. The video verification module prevents live presence imitation, identifies the user by biometrics, and allows approval of the operation when the user performs an individual gesture. © 2023 IEEE.},
	author_keywords = {biometry; cybercrime; fraud; remote banking system; social engineering; unified biometric system},
