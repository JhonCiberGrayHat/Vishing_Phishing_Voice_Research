}

@CONFERENCE{Rege2025,
	author = {Rege, Aunshul and Featherson, Micah and Swope, Jacqueline and Bleiman, Rachel},
	title = {Manipulating Minds with Machines: A Cybersecurity Course Project on AI-Enhanced Social Engineering Attacks},
	year = {2025},
	journal = {2025 15th IEEE Integrated STEM Education Conference, ISEC 2025},
	pages = {},
	doi = {10.1109/ISEC64801.2025.11147334},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105017798390&doi=10.1109%2FISEC64801.2025.11147334&partnerID=40&md5=e63ecfc6b9a61c84826c5907621ad6fb},
	affiliations = {Department of Criminal Justice, Temple University, United States; Klein College of Media and Communication, Temple University, United States; Department of Psychology, Temple University, United States},
	abstract = {The convergence of Artificial Intelligence (AI) and cybersecurity has reshaped the landscape of social engineering (SE) attacks, introducing new challenges for defense strategies. This paper explores the design and implementation of an innovative classroom pilot project aimed at equipping the next generation of cybersecurity professionals with the skills and insights needed to understand AI-enhanced SE tactics. Through a simulated environment, students take on the role of threat actors, leveraging AI tools to craft and execute SE attacks, including phishing and vishing, while adhering to ethical guidelines. The project fosters experiential learning by immersing students in the adversarial mindset, enhancing their understanding of how AI-driven techniques exploit human vulnerabilities. The student performance and experiences reveal their understanding of how cybercriminals can use AI to create lifelike personas, craft context-specific and persuasive pretexts, facilitate automation, and assist with rapid iteration and adaptability. This project thus emphasizes the importance of a proactive, hands-on approach to cybersecurity education, highlighting the need for a comprehensive understanding of psychological dimensions of cyber threats that are amplified, streamlined, and efficient via AI.  © 2025 IEEE.},
	author_keywords = {Artificial Intelligence; Cybersecurity Education; Cybersecurity Ethics; Experiential Learning; Social Engineering},
	keywords = {Adversarial machine learning; Computer crime; Curricula; Cybersecurity; Engineering education; Ethical technology; Network security; Students; Teaching; Course projects; Cyber security; Cyber-security educations; Cybersecurity ethic; Defense strategy; Design and implementations; Experiential learning; Pilot programs; Simulated environment; Social engineering; Artificial intelligence},
