	journal = {ASIA CCS 2016 - Proceedings of the 11th ACM Asia Conference on Computer and Communications Security},
	pages = {723 - 734},
	doi = {10.1145/2897845.2897890},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84979700557&doi=10.1145%2F2897845.2897890&partnerID=40&md5=4a88fff49eb9c597d6b1548cd698adfe},
	affiliations = {Trend Micro Research, United States; New York University, Abu Dhabi, United Arab Emirates; Singapore Management University, Singapore; Georgia Institute of Technology, New York University, Abu Dhabi, United Arab Emirates},
	abstract = {Over the past decade, the number of mobile phones has increased dramatically, overtaking the world population in October 2014. In developing countries like India and China, mobile subscribers outnumber traditional landline users and account for over 90% of the active population. At the same time, convergence of telephony with the Internet with technologies like VoIP makes it possible to reach a large number of telephone users at a low or no cost via voice calls or SMS (short message service) messages. As a consequence, cy-bercriminals are abusing the telephony channel to launch attacks, e.g., scams that offer fraudulent services and voice-based phishing or vishing, that have previously relied on the Internet. In this paper, we introduce and deploy the first mobile phone honeypot called MobiPot that allow us to collect fraudulent calls and SMS messages. We implement multiple ways of advertising mobile numbers (honeycards) on MobiPot to investigate how fraudsters collect phone numbers that are targeted by them. During a period of over seven months, MobiPot collected over two thousand voice calls and SMS messages, and we confirmed that over half of them were unsolicited. We found that seeding honeycards enables us to discover attacks on the mobile phone numbers which were not known before. © 2016 ACM.},
	keywords = {Cellular telephones; Developing countries; Information dissemination; Internet telephony; Mobile phones; Personal communication systems; Telephone sets; Text messaging; Fraudsters; Mobile subscribers; Mobile telephony; Phone number; SMS (short message service); SMS messages; Voice calls; World population; Internet},
	publisher = {Association for Computing Machinery, Inc},
	isbn = {978-145034233-9},
	language = {English},
	abbrev_source_title = {ASIA CCS - Proc. ACM Asia Conf. Comput. Commun. Secur.},
	type = {Conference paper},
