@CONFERENCE{Obuhuma2020,
	author = {Obuhuma, James and Zivuku, Shingai},
	title = {Social Engineering Based Cyber-Attacks in Kenya},
	year = {2020},
	journal = {2020 IST-Africa Conference, IST-Africa 2020},
	pages = {},
