	publisher = {Academic Press},
	issn = {10848045},
	language = {English},
	abbrev_source_title = {J Network Comput Appl},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 68; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

